APP_NAME=TaskFlow
APP_ENV=development

# Database Configuration
# Local host development: mongodb://localhost:27017
# Docker Compose network: mongodb://mongodb:27017
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=taskflow

# Redis Configuration
# Local host development: redis://localhost:6379/0
# Docker Compose network: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
